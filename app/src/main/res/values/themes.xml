<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动窗口：浅色纯白 / 深色 #0B0C0F，与首页一致，避免冷启动闪色 -->
    <style name="Theme.mpvex" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
    <!-- 播放页：黑色背景，避免进入时闪白 -->
    <style name="Theme.MagnetPlayer.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
